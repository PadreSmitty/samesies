{
  "hosting": [
    {
      "target": "game",
      "public": ".",
      "ignore": [
        "firebase.json", ".firebaserc", "**/.*", "**/node_modules/**",
        "src/**", "test/**", "studio/**", "package.json", "package-lock.json",
        "README.md", "ORIGIN.md", "firestore.rules"
      ],
      "headers": [
        { "source": "live.json", "headers": [
          { "key": "Access-Control-Allow-Origin", "value": "*" },
          { "key": "Cache-Control", "value": "no-store" }
        ] },
        { "source": "sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "**/*.@(js|css|html|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "**/*.@(webp|png|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
      ]
    },
    {
      "target": "studio",
      "public": "studio",
      "headers": [
        { "source": "**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
      ]
    }
  ],
  "firestore": { "rules": "firestore.rules" }
}
