rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /games/{code} {
      function signedIn() { return request.auth != null; }
      function isPlayer() { return request.auth.uid in resource.data.players; }

      // Anyone signed in can open a game by its code.
      allow get: if signedIn();
      // Only Smitty's phone can list every game (the stats page).
      allow list: if request.auth != null && request.auth.uid == "xi6uLt4nSKayDrGDmbSb9T7GzKA2";

      // Anyone signed in can start a game, as its host and only player.
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.players.keys().hasOnly([request.auth.uid]);

      // Players update the game; newcomers can add themselves while it's in the lobby.
      allow update: if signedIn()
        && request.resource.data.players.size() <= 5
        && (isPlayer()
            || (resource.data.status == 'lobby' && request.auth.uid in request.resource.data.players));

      // Secret words. You can write only your own, only once,
      // and nobody can read anyone else's until the round is revealed.
      match /rounds/{round}/subs/{uid} {
        function game() { return get(/databases/$(database)/documents/games/$(code)).data; }

        allow create: if signedIn()
          && request.auth.uid == uid
          && request.auth.uid in game().players
          && game().round == int(round);

        allow read: if signedIn()
          && (request.auth.uid == uid || game().revealed >= int(round));
      }
    }
  }
}
